        function syncFightByVideoTime(currentTime) {
            let matchedIndex = TARGET_INDEX; 

            for (let i = TARGET_INDEX; i < timerSequence.length; i++) {
                if (currentTime >= timerSequence[i].videoTime) {
                    matchedIndex = i;
                } else {
                    break;
                }
            }

            if (matchedIndex !== sequenceIndex) {
                sequenceIndex = matchedIndex;
                const curr = timerSequence[sequenceIndex];
                
                meronPool = curr.meronMax;
                walaPool = curr.walaMax;

                rebuildHistoryUpTo(sequenceIndex);
                recalculateOdds();
                updateUI();
                renderCrystalRoadMap();
            }

            const activeRound = timerSequence[sequenceIndex];
            const globalOverlay = document.getElementById('global-result-overlay');
            const meronOverlay = document.getElementById('meron-winner-overlay');
            const walaOverlay = document.getElementById('wala-winner-overlay');
            
            if (activeRound.endTime && currentTime >= activeRound.endTime && currentTime <= (activeRound.endTime + 4)) {
                const winner = activeRound.winner;
                
                if (winner === 'meron') {
                    meronOverlay.classList.remove('hidden');
                    walaOverlay.classList.add('hidden');
                    globalOverlay.classList.add('hidden');
                } else if (winner === 'wala') {
                    walaOverlay.classList.remove('hidden');
                    meronOverlay.classList.add('hidden');
                    globalOverlay.classList.add('hidden');
                } else if (winner === 'draw') {
                    meronOverlay.classList.add('hidden');
                    walaOverlay.classList.add('hidden');
                    globalOverlay.className = "absolute inset-0 z-30 flex flex-col items-center justify-center p-4 bg-green-950/90 border-2 border-green-500/80 backdrop-blur-sm";
