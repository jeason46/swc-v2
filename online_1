            const betAmount = selectedBetAmounts[side];
            if (betAmount <= 0) {
                showToast("Tap +100, +500, or +1k to choose bet amount", "fa-info-circle");
                return;
            }

            if (walletBalance >= betAmount) {
                walletBalance -= betAmount;
                if (side === 'meron') {
                    meronUserBet += betAmount;
                    meronPool += betAmount;
                    selectedBetAmounts.meron = 0;
                } else {
                    walaUserBet += betAmount;
                    walaPool += betAmount;
                    selectedBetAmounts.wala = 0;
                }

                localStorage.setItem('swc_wallet', walletBalance);
                recalculateOdds();
                updateUI();
                showToast(`Successfully placed ${formatPHP(betAmount)} on ${side.toUpperCase()}!`, "fa-circle-check");
            } else {
                showToast("Insufficient balance!", "fa-circle-xmark");
            }
        }

        function recalculateOdds() {
            const total = meronPool + walaPool;
            if (total > 0) {
                const commission = 0.90; 
                meronPayout = (total * commission) / meronPool;
                walaPayout = (total * commission) / walaPool;

                if (meronPayout < 1.05) meronPayout = 1.05;
                if (walaPayout < 1.05) walaPayout = 1.05;
            }
        }

        function toggleFightStatusAdmin() {
            currentStatusIdx = (currentStatusIdx + 1) % statusList.length;
            const status = statusList[currentStatusIdx];
            
            const badge = document.getElementById('fight-status-badge');
            badge.className = `${status.color} font-extrabold text-xs px-3 py-1 rounded-sm uppercase tracking-wider flex items-center space-x-1.5 shadow`;
            document.getElementById('status-text').innerText = status.text;

            showToast(`Fight Status set to: ${status.text}`, "fa-gear");
            updateUI();
        }

        function toggleStreamMode() {
            isLiveStream = !isLiveStream;
            localStorage.setItem('swc_is_live', isLiveStream);
            restoreVideoState();

            if (isLiveStream) {
                showToast("Switched to Live Arena Feed", "fa-video");
            } else {
                showToast("Switched to Main V1 Backup Stream", "fa-video");
            }
        }

        function refreshStream() {
            recalculateOdds();
            renderCrystalRoadMap();
            updateUI();
            showToast("Continuous Sync Done - Video & Bets Preserved!", "fa-rotate");
        }

        function toggleFullscreen() {
            const videoEl = document.getElementById('live-video-element');
            if (videoEl) {
                if (videoEl.requestFullscreen) {
                    videoEl.requestFullscreen();
                } else if (videoEl.webkitRequestFullscreen) {
                    videoEl.webkitRequestFullscreen();
                } else if (videoEl.msRequestFullscreen) {
                    videoEl.msRequestFullscreen();
                }
            }
            showToast("Fullscreen mode triggered", "fa-expand");
        }

        function resetWallet() {
            walletBalance += 1000;
            localStorage.setItem('swc_wallet', walletBalance);
            updateUI();
            showToast("Added ₱1,000.00 test funds to wallet!", "fa-wallet");
        }

        function toggleSideMenu() {
            const menu = document.getElementById('side-menu');
            menu.classList.toggle('hidden');
        }

        function showToast(msg, icon = "fa-circle-info") {
            const toast = document.getElementById('toast-msg');
            const toastText = document.getElementById('toast-text');
            const toastIcon = document.getElementById('toast-icon');

            toastText.innerText = msg;
            toastIcon.className = `fa-solid ${icon} text-blue-400`;

            toast.classList.remove('opacity-0', 'pointer-events-none');
            toast.classList.add('opacity-100');

            setTimeout(() => {
                toast.classList.remove('opacity-100');
                toast.classList.add('opacity-0', 'pointer-events-none');
            }, 2500);
        }
    </script>
</body>
</html>
