            const seekbar = document.getElementById('video-seekbar');
            const currentTimeDisp = document.getElementById('current-time-disp');
            const durationDisp = document.getElementById('duration-disp');

            if (videoEl) {
                videoEl.addEventListener('timeupdate', () => {
                    if (!isNaN(videoEl.duration)) {
                        const progress = (videoEl.currentTime / videoEl.duration) * 100;
                        seekbar.value = progress;
                        currentTimeDisp.innerText = formatVideoTime(videoEl.currentTime);
                        
                        const timeLeft = videoEl.duration - videoEl.currentTime;
                        durationDisp.innerText = '-' + formatVideoTime(timeLeft);

                        syncFightByVideoTime(videoEl.currentTime);
                    }
                });

                videoEl.addEventListener('ended', () => {
                    videoEl.currentTime = timerSequence[TARGET_INDEX].videoTime;
                    videoEl.play().catch(() => {});
                });
            }
