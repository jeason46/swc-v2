                    document.getElementById('result-title-display').className = "text-4xl font-black font-teko green-glow-text tracking-widest uppercase leading-none";
                    document.getElementById('result-title-display').innerText = "DRAW!";
                    document.getElementById('result-sub-text').innerText = "ALL BETS REFUNDED";
                    globalOverlay.classList.remove('hidden');
                } else if (winner === 'cancel' || winner === 'cancelled') {
                    meronOverlay.classList.add('hidden');
                    walaOverlay.classList.add('hidden');
                    globalOverlay.className = "absolute inset-0 z-30 flex flex-col items-center justify-center p-4 bg-gray-900/90 border-2 border-gray-500/80 backdrop-blur-sm";
                    document.getElementById('result-icon-container').innerHTML = `<i class="fa-solid fa-ban text-5xl gray-glow-text mb-1 animate-pulse"></i>`;
                    document.getElementById('result-title-display').className = "text-4xl font-black font-teko gray-glow-text tracking-widest uppercase leading-none";
                    document.getElementById('result-title-display').innerText = "CANCELLED";
                    document.getElementById('result-sub-text').innerText = "FIGHT VOIDED / REFUNDED";
                    globalOverlay.classList.remove('hidden');
                }
            } else {
                meronOverlay.classList.add('hidden');
                walaOverlay.classList.add('hidden');
                globalOverlay.classList.add('hidden');
            }
        }

