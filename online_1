        function renderCrystalRoadMap() {
            const grid = document.getElementById('crystal-road-grid');
            grid.innerHTML = '';

            if (fightHistoryRecords.length === 0) return;

            const MAX_ROWS = 6;
            let columnGroups = [];
            let currentGroup = [];
            let lastWinner = null;

            fightHistoryRecords.forEach((record) => {
                if (lastWinner === null || record.winner !== lastWinner) {
                    if (currentGroup.length > 0) {
                        columnGroups.push(currentGroup);
                    }
                    currentGroup = [record];
                } else {
                    if (currentGroup.length < MAX_ROWS) {
                        currentGroup.push(record);
                    } else {
                        columnGroups.push(currentGroup);
                        currentGroup = [record];
                    }
                }
                lastWinner = record.winner;
            });

            if (currentGroup.length > 0) {
                columnGroups.push(currentGroup);
            }

            columnGroups.forEach((group) => {
                const colDiv = document.createElement('div');
                colDiv.className = "flex flex-col space-y-1.5 flex-shrink-0";

                for (let r = 0; r < MAX_ROWS; r++) {
                    const item = group[r];
                    const cellDiv = document.createElement('div');
                    cellDiv.className = "w-7 h-7 flex items-center justify-center";

                    if (item) {
                        let circleStyle = '';
                        if (item.winner === 'meron') {
                            circleStyle = 'border-red-500 text-red-400 bg-red-950/80 shadow-red-900/50';
                        } else if (item.winner === 'wala') {
                            circleStyle = 'border-blue-500 text-blue-400 bg-blue-950/80 shadow-blue-900/50';
                        } else if (item.winner === 'draw') {
                            circleStyle = 'border-green-500 text-green-400 bg-green-950/80 shadow-green-900/50';
                        } else if (item.winner === 'cancel' || item.winner === 'cancelled') {
                            circleStyle = 'border-gray-500 text-gray-300 bg-gray-800/80 shadow-gray-700/50';
                        }

                        cellDiv.innerHTML = `
                            <div class="w-7 h-7 rounded-full border-2 ${circleStyle} flex items-center justify-center font-black text-[10px] font-teko shadow-md">
                                ${item.fight}
                            </div>
                        `;
                    }
                    colDiv.appendChild(cellDiv);
                }
                grid.appendChild(colDiv);
            });

            const container = document.getElementById('road-map-scroll-container');
            container.scrollLeft = container.scrollWidth;
            container.scrollTop = 0;
        }

        function setupRoadMapDragScroll() {
            const slider = document.getElementById('road-map-scroll-container');
            let isDown = false;
            let startX, startY, scrollLeft, scrollTop;

            slider.addEventListener('mousedown', (e) => {
                isDown = true;
                slider.classList.add('active');
                startX = e.pageX - slider.offsetLeft;
                startY = e.pageY - slider.offsetTop;
                scrollLeft = slider.scrollLeft;
                scrollTop = slider.scrollTop;
            });

            slider.addEventListener('mouseleave', () => { isDown = false; });
            slider.addEventListener('mouseup', () => { isDown = false; });

            slider.addEventListener('mousemove', (e) => {
                if (!isDown) return;
                e.preventDefault();
                const x = e.pageX - slider.offsetLeft;
                const y = e.pageY - slider.offsetTop;
                slider.scrollLeft = scrollLeft - ((x - startX) * 1.5);
                slider.scrollTop = scrollTop - ((y - startY) * 1.5);
            });
        }

